# ==========================================================
# SyncLM Studio Configuration
# ==========================================================

# Port and Server configuration
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Google Cloud Platform Service Account Credentials
# Option 1: Path to service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=credentials/service_account.json

# Option 2: Raw JSON string of the service account
# GCP_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}'

# Option 3: Base64-encoded service account key
# GCP_SA_KEY_B64=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsCiAg...

# Scraping Engine Settings
MAX_CONCURRENT_REQUESTS=4
REQUEST_TIMEOUT_SECONDS=25
USER_AGENT=SyncLM-Studio/1.0 (+https://github.com/arich2day/panw-techdocs-crwlr)
DEFAULT_DRY_RUN=false
